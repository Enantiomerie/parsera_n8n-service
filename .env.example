# ------------------------------------------------------------
# Parsera n8n Service
# ------------------------------------------------------------

SERVICE_NAME=parsera-n8n-service
LOG_LEVEL=INFO


# ------------------------------------------------------------
# LLM Provider
#
# Valid values:
#   parsera
#   gemini
#   openai
#   ollama
# ------------------------------------------------------------

LLM_PROVIDER=gemini


# ------------------------------------------------------------
# Parsera native API
#
# Used when:
#   LLM_PROVIDER=parsera
# ------------------------------------------------------------

PARSERA_API_KEY=


# ------------------------------------------------------------
# Gemini
#
# Used when:
#   LLM_PROVIDER=gemini
# ------------------------------------------------------------

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# ------------------------------------------------------------
# OpenAI
#
# Used when:
#   LLM_PROVIDER=openai
# ------------------------------------------------------------

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=


# ------------------------------------------------------------
# Ollama
#
# Used when:
#   LLM_PROVIDER=ollama
# ------------------------------------------------------------

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama2


# ------------------------------------------------------------
# Runtime limits
# ------------------------------------------------------------

# Maximum allowed URL length for /scrape requests.
MAX_URL_LENGTH=2000

# Maximum allowed length for extraction_rules and each value in elements.
MAX_EXTRACTION_RULES_LENGTH=5000

# If true, the service checks that Parsera's result is JSON serializable.
VALIDATE_JSON_OUTPUT=true

# Maximum allowed scrolls per request.
# 0 means scrolling is disabled.
PARSERA_SCROLLS_LIMIT=10


# ------------------------------------------------------------
# Timeouts
# ------------------------------------------------------------

# Timeout for LLM/model requests in seconds.
REQUEST_TIMEOUT_SECONDS=60

# Default timeout for wait_selector in milliseconds.
DEFAULT_WAIT_TIMEOUT_MS=15000
