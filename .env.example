# Parsera Configuration Example
# Copy to .env and update only the necessary values for your deployment.
# Note: Service hostnames (e.g. `browserless`) should be provided by the Docker stack/network, not as URL env vars.

# Service Configuration
LOG_LEVEL=INFO

# Browserless (host/port are provided by the stack; keep runtime tuning here)
BROWSERLESS_TIMEOUT=30
BROWSERLESS_RETRIES=1

# LLM Provider: gemini, openai, or ollama
LLM_PROVIDER=gemini

# Google Gemini (when using gemini provider)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI (when using openai provider)
# Provide API key only; model can remain configurable
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# Ollama (when using ollama provider)
# The Ollama host should be the service name in the stack; only the model is needed here
# OLLAMA_BASE_URL is intentionally omitted (set via stack service).
OLLAMA_MODEL=llama2

# Request Configuration
REQUEST_TIMEOUT=60
MAX_URL_LENGTH=2000
MAX_EXTRACTION_RULES_LENGTH=5000

# Validation
VALIDATE_JSON_OUTPUT=true
