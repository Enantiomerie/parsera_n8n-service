# Parsera Configuration Example
# Copy to .env and update only the necessary values for your deployment.
# Service hostnames (e.g. `browserless`) are usually provided by the Docker stack/network.
# Prefer HOST + PORT variables for flexibility. If your app expects a full URL, use the *_URL variants (examples shown commented).

# Service
LOG_LEVEL=INFO

# Browserless (preferred: host + port)
BROWSERLESS_HOST=browserless
BROWSERLESS_PORT=3000
# If your app expects a full URL, uncomment the following and remove/ignore HOST/PORT:
# BROWSERLESS_URL=http://browserless:3000
BROWSERLESS_TIMEOUT=30
BROWSERLESS_RETRIES=1

# LLM Provider: gemini, openai, or ollama
LLM_PROVIDER=gemini

# Google Gemini (when using gemini provider)
GEMINI_API_KEY=

# OpenAI (when using openai provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Ollama (preferred: host + port)
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
# If your app expects a full base URL, uncomment the following and remove/ignore HOST/PORT:
# OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama2

# Request configuration
REQUEST_TIMEOUT=60
MAX_URL_LENGTH=2000
MAX_EXTRACTION_RULES_LENGTH=5000

# Validation
VALIDATE_JSON_OUTPUT=true
