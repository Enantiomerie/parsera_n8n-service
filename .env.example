# Service
LOG_LEVEL=INFO

# LLM provider: gemini, openai, ollama
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama2

# Request limits
REQUEST_TIMEOUT=60
MAX_URL_LENGTH=2000
MAX_EXTRACTION_RULES_LENGTH=5000
VALIDATE_JSON_OUTPUT=true

# Parsera / Playwright
PLAYWRIGHT_STEALTH=true
CUSTOM_COOKIES_JSON=
PARSERA_SCROLLS_LIMIT=0
